<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mcl_world">

    <!-- Luz -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Piso -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Pared Norte -->
    <model name="pared_norte">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.2 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Pared Sur -->
    <model name="pared_sur">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.2 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Pared Este -->
    <model name="pared_este">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Pared Oeste -->
    <model name="pared_oeste">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Obstáculo 1 -->
    <model name="obstaculo_1">
      <static>true</static>
      <pose>2 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Obstáculo 2 -->
    <model name="obstaculo_2">
      <static>true</static>
      <pose>-2 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Obstáculo 3 -->
    <model name="obstaculo_3">
      <static>true</static>
      <pose>-2 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1 2 1</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
